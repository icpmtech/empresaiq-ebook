{
  "name": "empresaiq-ebook",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "copy-sqljs": "node -e \"const fs=require('fs');fs.mkdirSync('static/sqljs',{recursive:true});fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','static/sqljs/sql-wasm.wasm');fs.copyFileSync('node_modules/sql.js/dist/sql-wasm-browser.wasm','static/sqljs/sql-wasm-browser.wasm')\"",
    "copy-lessons": "node scripts/copy-lessons.js",
    "prepare-assets": "npm run copy-sqljs && npm run copy-lessons",
    "start": "npm run prepare-assets && docusaurus start",
    "build": "npm run prepare-assets && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "pdf": "node scripts/generate-pdf.js",
    "doc": "node scripts/generate-doc.js"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-mermaid": "^3.10.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-pageflip": "^2.0.3",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@types/react": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "docx": "^9.7.1",
    "marked": "^18.0.4",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.1.0",
    "raw-loader": "^4.0.2",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
