# EmpresaIQ Agent — Variáveis de Ambiente
# Copie para .env e preencha com os seus valores

# ─── EmpresaIQ REST API ───────────────────────────────────────────────────
EMPRESAIQ_BASE_URL=http://localhost:5000
EMPRESAIQ_USERNAME=admin
EMPRESAIQ_PASSWORD=admin

# ─── LLM — llama.cpp server (OpenAI-compatible) ──────────────────────────
# Inicie com: llama-server -m modelo.gguf --port 8080
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=local-model
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ─── (Opcional) OpenAI real em vez do modelo local ───────────────────────
# Descomente e preencha para usar GPT-4o-mini da OpenAI
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
